# Copy to .env.local. NEVER commit a real secret.
# Postgres 17 (Homebrew) is not brew-managed by default and needs a locale:
#   brew services start postgresql@17
#   export LC_ALL=en_US.UTF-8
LC_ALL=en_US.UTF-8

# The application connects ONLY as statesman_app: non-owner, no BYPASSRLS.
# A typo'd username connects successfully as whatever role is named (pg_hba is `trust`
# for local), which is why the role identity is asserted at runtime in the data path.
APP_DATABASE_URL=postgres://statesman_app@127.0.0.1:5432/statesman_dev
MIGRATOR_DATABASE_URL=postgres://statesman_migrator@127.0.0.1:5432/statesman_dev

# Integration tests clone a template per worker. Base URLs, worker appends the db name.
TEST_APP_DATABASE_URL_BASE=postgres://statesman_app@127.0.0.1:5432
TEST_MIGRATOR_DATABASE_URL_BASE=postgres://statesman_migrator@127.0.0.1:5432
TEST_TEMPLATE_DB=statesman_test_template

# AI mode is EXPLICIT. Never inferred from the presence of a key.
#   unavailable -> honest NFR-08 retry state, no feedback generated
#   fixture     -> deterministic fixtures, labelled in the UI, test/demo only
#   live        -> real provider; a missing key renders the unavailable state
STATESMAN_AI_MODE=unavailable
# ANTHROPIC_API_KEY=
