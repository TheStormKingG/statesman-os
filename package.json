{
  "name": "statesman-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:bootstrap": "bash scripts/db-bootstrap.sh",
    "db:migrate": "bash scripts/migrate.sh",
    "db:template": "bash scripts/db-template.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "boundaries": "tsx scripts/check-import-boundaries.ts",
    "gates": "bash scripts/gates.sh",
    "mutation": "bash scripts/mutation-check.sh",
    "gates:fast": "bash scripts/gates.sh --only test:integration"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5"
  }
}
